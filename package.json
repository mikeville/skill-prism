{
  "name": "skill-prism",
  "private": true,
  "version": "0.1.0",
  "description": "A fractal topic browser. Type a topic; Claude returns a Harada-style 9×9 decomposition. Click any cell to drill in.",
  "license": "MIT",
  "author": "Mike Deal",
  "repository": {
    "type": "git",
    "url": "https://github.com/mikeville/skill-prism.git"
  },
  "homepage": "https://github.com/mikeville/skill-prism#readme",
  "keywords": [
    "claude",
    "anthropic",
    "harada",
    "fractal",
    "learning",
    "vite",
    "react",
    "typography"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:netlify": "netlify dev",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource-variable/anybody": "^5.2.7",
    "@supabase/supabase-js": "^2.105.4",
    "hyphen": "^1.14.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@netlify/functions": "^2.8.0",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.0",
    "netlify-cli": "^17.36.0",
    "postcss": "^8.5.12",
    "prettier": "^3.3.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.2",
    "vite": "^5.3.1"
  }
}
