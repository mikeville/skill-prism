# Required: your Anthropic API key. Used by the Netlify function (dev + prod).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model override. Default is the cheapest current model.
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001  # default — cheapest
# ANTHROPIC_MODEL=claude-sonnet-4-6           # better quality, ~5× cost
# ANTHROPIC_MODEL=claude-opus-4-7             # best quality, ~15× cost

# Supabase — optional. Enables the shared server-side cache and the /admin dashboard.
# Find these in your Supabase project: Settings → API Keys.
# Use a secret key (`sb_secret_...`); it must never reach the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_...

# Admin dashboard token — paste this into /admin to unlock. Required if Supabase is configured.
# Generate any long random string, e.g. `openssl rand -hex 32`.
ADMIN_TOKEN=changeme-long-random-string

# Cache TTL in days. Older cached breakdowns are ignored and refetched.
# Default 30. Set to 0 to disable the server cache temporarily.
CACHE_TTL_DAYS=30

# skill-prism-skills-worker (Vercel) — companion project that proxies
# skills.sh's /api/v1/skills/search behind a shared secret. Required for
# the insight panel's "skill" move kind to show candidates.
#  - SKILLS_PROXY_URL is the deployed Vercel URL (e.g.
#    https://skill-prism-skills-worker.vercel.app) or http://localhost:3000
#    when running `vercel dev` locally.
#  - SKILLS_PROXY_SECRET must match the value set on the Vercel project.
SKILLS_PROXY_URL=
SKILLS_PROXY_SECRET=